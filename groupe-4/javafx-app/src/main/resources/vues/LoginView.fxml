<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<!--
  Écran de connexion.
  En haut : le titre.
  Au milieu : le champ email, puis le champ mot de passe, l'un sous l'autre.
  En dessous : le message d'erreur (caché tant qu'il n'y a pas d'erreur).
  Puis le bouton "Se connecter", et enfin le lien "Créer un compte" tout en bas.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.groupe4.controllers.LoginController"
      styleClass="ecran-connexion"
      alignment="CENTER"
      spacing="16">

    <padding>
        <Insets top="60" right="60" bottom="60" left="60" />
    </padding>

    <Label text="Connexion" styleClass="titre-ecran" />

    <VBox maxWidth="320" spacing="10">

        <Label text="Adresse email" styleClass="etiquette-champ" />
        <TextField fx:id="champEmail" promptText="exemple@email.com" />

        <Label text="Mot de passe" styleClass="etiquette-champ" />
        <PasswordField fx:id="champMotDePasse" promptText="Votre mot de passe" />

        <Label fx:id="messageErreur" styleClass="message-erreur" wrapText="true" managed="false" visible="false" />

        <Button fx:id="boutonConnexion" text="Se connecter" styleClass="bouton-principal" maxWidth="Infinity" onAction="#seConnecter" />

        <Hyperlink fx:id="lienInscription" text="Pas encore de compte ? Créer un compte" onAction="#allerVersInscription" />

    </VBox>

</VBox>
